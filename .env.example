SCRM_API_ADDR=127.0.0.1:8080
SCRM_DATABASE_URL=postgres://scrm:scrm@127.0.0.1:15432/scrm?sslmode=disable
SCRM_AUTO_MIGRATE=true
SCRM_DB_MAX_OPEN_CONNS=25
SCRM_DB_MAX_IDLE_CONNS=10
SCRM_DB_CONN_MAX_LIFETIME=30m
SCRM_WORKER_INTERVAL=500ms
SCRM_WORKER_BATCH_SIZE=20
SCRM_WORKER_MAX_ATTEMPTS=3
SCRM_WORKER_RETRY_DELAY=2s
SCRM_RATE_LIMIT_RPS=80
SCRM_RATE_LIMIT_BURST=160
SCRM_API_TOKEN=
SCRM_BUSINESS_TIME_ZONE=Asia/Shanghai
SCRM_CACHE_TTL=5s
SCRM_CACHE_MAX_ENTRIES=512
SCRM_REDIS_ADDR=127.0.0.1:16379
SCRM_REDIS_PASSWORD=
SCRM_REDIS_DB=0
SCRM_REDIS_KEY_PREFIX=scrm:cache:
