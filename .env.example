# Local runtime ports. SCRM_API_ADDR wins; BACKEND_PORT is a convenience
# fallback used when SCRM_API_ADDR is not set.
BACKEND_PORT=8080
FRONTEND_PORT=5173
SCRM_API_ADDR=127.0.0.1:8080

# Database mode:
# - memory: leave DATABASE_URL/SCRM_DATABASE_URL empty
# - postgres: set DATABASE_URL or SCRM_DATABASE_URL
SCRM_DATABASE_MODE=postgres

# Standard development database suggestion. Do not overwrite an existing
# local Docker volume just to match these values; create scrm_dev or put your
# actual local DSN in .env.
DATABASE_URL=postgres://scrm:scrm@127.0.0.1:15432/scrm_dev?sslmode=disable
SCRM_DATABASE_URL=postgres://scrm:scrm@127.0.0.1:15432/scrm_dev?sslmode=disable
# Use a temporary/non-15432 database for DB tests and E2E cleanup.
# SCRM_TEST_DATABASE_URL=postgres://scrm:scrm@127.0.0.1:15433/scrm_test?sslmode=disable
SCRM_AUTO_MIGRATE=true
SCRM_DB_MAX_OPEN_CONNS=25
SCRM_DB_MAX_IDLE_CONNS=10
SCRM_DB_CONN_MAX_LIFETIME=30m
SCRM_WORKER_INTERVAL=500ms
SCRM_WORKER_BATCH_SIZE=20
SCRM_WORKER_MAX_ATTEMPTS=3
SCRM_WORKER_RETRY_DELAY=2s
SCRM_RATE_LIMIT_RPS=80
SCRM_RATE_LIMIT_BURST=160
SCRM_API_TOKEN=
SCRM_BUSINESS_TIME_ZONE=Asia/Shanghai
SCRM_CACHE_TTL=5s
SCRM_CACHE_MAX_ENTRIES=512
SCRM_REDIS_ADDR=127.0.0.1:16379
SCRM_REDIS_PASSWORD=
SCRM_REDIS_DB=0
SCRM_REDIS_KEY_PREFIX=scrm:cache:
SCRM_SECRET_ENCRYPTION_KEY=

# Optional Monobase SCRM data foundation. jianghu-scrm pulls standardized
# scrm_/wecom_ fields from these integration APIs instead of calling WeCom
# directly.
MONOBASE_BASE_URL=http://127.0.0.1:19090
MONOBASE_INTEGRATION_TOKEN=monobase-scrm-integration-dev-token
MONOBASE_CORP_ACCOUNT_ID=1
MONOBASE_SYNC_PAGE_SIZE=100

# Optional local seed values for the Enterprise WeChat pilot.
WECOM_CORP_ID=
WECOM_AGENT_ID=
WECOM_SECRET=
WECOM_CALLBACK_TOKEN=
WECOM_CALLBACK_AES_KEY=
WECOM_TRUSTED_IP_HINT=
# Set true for local API/UI smoke tests that should not call Enterprise WeChat.
WECOM_CONTACT_WAY_DRY_RUN=false
